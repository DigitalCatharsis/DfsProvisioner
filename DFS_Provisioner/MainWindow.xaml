<Window x:Class="DFS_Provisioner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="DFS Provisioner"
        Height="700" Width="950"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Top config -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="Config file:" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBox Text="{Binding ConfigFilePath}" Width="350" IsReadOnly="True" Background="#F5F5F5"/>
            <Button Content="Load" Width="80" Margin="5,0,0,0" Command="{Binding LoadConfigCommand}"/>
            <Button Content="Save" Width="80" Margin="5,0,0,0" Command="{Binding SaveConfigCommand}"/>
        </StackPanel>

        <TabControl Grid.Row="1">
            <!-- Credentials -->
            <TabItem Header="Credentials">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <GroupBox Header="Domain and Servers" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Domain:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding DomainName}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="AD User:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding AdUsername}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="AD Password:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,5"/>
                                <PasswordBox x:Name="AdPasswordBox" Grid.Row="2" Grid.Column="1" Style="{StaticResource PasswordBoxStyle}"/>

                                <TextBlock Text="Server:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding ShareServer}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Server User:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding ServerUsername}" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>

                                <TextBlock Text="Server Password:" VerticalAlignment="Center" Grid.Row="5" Grid.Column="0" Margin="0,0,10,5"/>
                                <PasswordBox x:Name="ServerPasswordBox" Grid.Row="5" Grid.Column="1" Style="{StaticResource PasswordBoxStyle}"/>
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- AD Groups -->
            <TabItem Header="AD Groups">
                <StackPanel Margin="15">
                    <GroupBox Header="Group Properties" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Groups OU (DN):" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding GroupsOU}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Text="Read Group Name:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding ReadGroupName}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Text="Write Group Name:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding WriteGroupName}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Text="Description Template:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding GroupDescriptionTemplate}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Text="Notes Template:" VerticalAlignment="Center" Grid.Row="4" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding GroupNotesTemplate}" Grid.Row="4" Grid.Column="1" Margin="0,0,0,5"/>

                            <!-- Preview -->
                            <TextBlock Grid.Row="5" Grid.ColumnSpan="2" Margin="0,10,0,5" FontWeight="SemiBold">
                                <Run Text="Group locations preview:"/>
                            </TextBlock>
                            <TextBlock Grid.Row="6" Grid.ColumnSpan="2" Text="{Binding AdGroupPreviewRead}" Foreground="Gray"/>
                            <TextBlock Grid.Row="7" Grid.ColumnSpan="2" Text="{Binding AdGroupPreviewWrite}" Foreground="Gray"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Share & NTFS -->
            <TabItem Header="Share and NTFS">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <GroupBox Header="Share configuration" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="Local path (full):" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding LocalPath, ValidatesOnDataErrors=True}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"
                                         Style="{StaticResource ValidatedTextBox}"/>

                                <TextBlock Text="Share name (auto):" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding ShareFolderName, Mode=OneWay}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"
                                         IsReadOnly="True" Background="#F5F5F5"/>

                                <TextBlock Text="Share UNC preview:" VerticalAlignment="Center" Grid.Row="2" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding ShareUncPreview, Mode=OneWay}" Grid.Row="2" Grid.Column="1" Margin="0,0,0,5"
                                         IsReadOnly="True" Background="#F5F5F5"/>

                                <TextBlock Text="Folder owner:" VerticalAlignment="Center" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5"/>
                                <TextBox Text="{Binding OwnerAccount}" Grid.Row="3" Grid.Column="1" Margin="0,0,0,5"/>

                                <CheckBox Content="Remove Everyone from share permissions" IsChecked="{Binding RemoveEveryoneFromShare}"
                                          Grid.Row="4" Grid.Column="1" HorizontalAlignment="Left" Margin="0,5,0,0"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="NTFS permissions (from groups)" Padding="10" Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Read group: "/><Run Text="{Binding ReadGroupName, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" – read &amp; execute"/>
                                </TextBlock>
                                <TextBlock Margin="0,5,0,0">
                                    <Run Text="Write group: "/><Run Text="{Binding WriteGroupName, Mode=OneWay}" FontWeight="Bold"/>
                                    <Run Text=" – modify"/>
                                </TextBlock>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- DFS -->
            <TabItem Header="DFS">
                <StackPanel Margin="15">
                    <GroupBox Header="DFS Namespace" Padding="10">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="Namespace root:" VerticalAlignment="Center" Grid.Row="0" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding NamespaceRoot}" Grid.Row="0" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Text="Link template:" VerticalAlignment="Center" Grid.Row="1" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding LinkNameTemplate}" Grid.Row="1" Grid.Column="1" Margin="0,0,0,5"/>

                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Margin="0,10,0,5" FontWeight="SemiBold">Preview:</TextBlock>
                            <TextBlock Text="DFS path:" Grid.Row="3" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding DfsPathPreview, Mode=OneWay}" Grid.Row="3" Grid.Column="1" IsReadOnly="True" Background="#F5F5F5"/>

                            <TextBlock Text="Target:" Grid.Row="4" Grid.Column="0" Margin="0,0,10,5"/>
                            <TextBox Text="{Binding DfsTargetPreview, Mode=OneWay}" Grid.Row="4" Grid.Column="1" IsReadOnly="True" Background="#F5F5F5"/>
                        </Grid>
                    </GroupBox>
                </StackPanel>
            </TabItem>

            <!-- Log -->
            <TabItem Header="Log">
                <Grid Margin="10">
                    <RichTextBox x:Name="LogRichTextBox" IsReadOnly="True" Background="#1E1E1E"
                                 FontFamily="Consolas" FontSize="12" VerticalScrollBarVisibility="Auto">
                        <RichTextBox.Resources>
                            <Style TargetType="Paragraph">
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </RichTextBox.Resources>
                    </RichTextBox>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- Bottom buttons -->
        <Grid Grid.Row="2" Margin="0,5,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="1. Check all" Width="120" Margin="0,0,10,0" Command="{Binding CheckAllCommand}"/>
                <Button Content="2. Create AD groups" Width="140" Margin="0,0,10,0" Command="{Binding CreateGroupsCommand}"/>
                <Button Content="3. Create share and NTFS" Width="160" Margin="0,0,10,0" Command="{Binding CreateShareAndSecurityCommand}"/>
                <Button Content="4. Setup DFS" Width="130" Margin="0,0,10,0" Command="{Binding SetupDfsCommand}"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Run all" Width="150" Height="30" Command="{Binding RunAllCommand}"
                        Background="#0078D4" Foreground="White" FontWeight="SemiBold"/>
                <Button Content="Clear log" Width="100" Height="30" Margin="10,0,0,0" Command="{Binding ClearLogCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>